// Master metadata field registry. One line per field:
//   F(Enum, "id", Group, "Label", "unit", Type, "Livegrade equivalent", "OpenTrackIO path", "FreeD")
// "id" is the stable key: OSC address suffix (<prefix>/<id>), JSON log key and docs/fields.json key. Don't rename ids.
// Add new fields at the end of their group; order is the display order.

// ---- identity
F(Camera,            "camera",            Identity, "Camera",                     "",     String, "Camera Model",     "static.camera.make + model", "")
F(CameraMake,        "camera_make",       Identity, "Camera make",                "",     String, "",                 "static.camera.make", "")
F(CameraModel,       "camera_model",      Identity, "Camera model",               "",     String, "Camera Model",     "static.camera.model", "")
F(CameraSerial,      "camera_serial",     Identity, "Camera serial",              "",     String, "",                 "static.camera.serialNumber", "")
F(CameraFirmware,    "camera_firmware",   Identity, "Camera software",            "",     String, "Software Version", "static.camera.firmwareVersion", "")
F(CameraIndex,       "camera_index",      Identity, "Camera letter",              "",     String, "",                 "static.camera.label", "")
F(Lens,              "lens",              Identity, "Lens",                       "",     String, "Lens Model",       "", "")
F(LensModel,         "lens_model",        Identity, "Lens model",                 "",     String, "Lens Model",       "static.lens.model", "")
F(LensSerial,        "lens_serial",       Identity, "Lens serial / ID",           "",     String, "",                 "static.lens.serialNumber", "")
// ---- lens (dynamic)
F(FocusDistance,     "focus",             Lens,     "Focus distance",             "m",    Float,  "Focus Distance",   "lens.focusDistance", "focus")
F(FocusPosition,     "focus_normalised",  Lens,     "Focus position (0 near - 1 far)", "", Float, "",               "lens.encoders.focus (inverted)", "")
F(Iris,              "iris",              Lens,     "Iris",                       "",     Float,  "Aperture",         "lens.tStop / lens.fStop", "spare (x100)")
F(FocalLength,       "zoom",              Lens,     "Focal length",               "mm",   Float,  "Focal Length",     "lens.pinholeFocalLength", "zoom")
F(FocalLength35,     "focal_length_35mm", Lens,     "Focal length (35mm equiv.)", "mm",   Float,  "",                 "", "")
F(EntrancePupil,     "entrance_pupil",    Lens,     "Entrance pupil position",    "mm",   Float,  "",                 "lens.entrancePupilOffset", "")
F(EffectiveFocal,    "effective_focal_length", Lens, "Effective focal length",    "mm",   Float,  "",                 "", "")
F(Extender,          "extender",          Lens,     "Extender / converter",       "x",    Float,  "",                 "", "")
F(LensDataLag,       "lens_data_lag",     Lens,     "Lens data lag",              "frames", Int,  "",                 "", "")
// ---- exposure
F(Iso,               "iso",               Exposure, "ISO / EI",                   "",     Int,    "EI/ISO",           "static.camera.isoSpeed", "")
F(ShutterAngle,      "shutter_angle",     Exposure, "Shutter angle",              "deg",  Float,  "Shutter Angle",    "static.camera.shutterAngle", "")
F(ExposureTime,      "exposure_time",     Exposure, "Exposure time",              "s",    Float,  "",                 "", "")
F(WhiteBalance,      "white_balance",     Exposure, "White balance",              "K",    Int,    "White Balance",    "", "")
F(Tint,              "tint",              Exposure, "Tint",                       "",     Float,  "Tint",             "", "")
F(NdDensity,         "nd",                Exposure, "ND (optical density)",       "",     Float,  "ND Filter",        "", "")
F(Gain,              "gain",              Exposure, "Master gain",                "dB",   Float,  "",                 "", "")
// ---- image
F(CaptureFps,        "capture_fps",       Image,    "Capture frame rate",         "fps",  Float,  "Sensor FPS",       "static.camera.captureFrameRate", "")
F(ProjectFps,        "project_fps",       Image,    "Project frame rate",         "fps",  Float,  "Project FPS",      "", "")
F(SensorWidth,       "sensor_width",      Image,    "Sensor width (active)",      "mm",   Float,  "",                 "static.camera.activeSensorPhysicalDimensions.width", "")
F(SensorHeight,      "sensor_height",     Image,    "Sensor height (active)",     "mm",   Float,  "",                 "static.camera.activeSensorPhysicalDimensions.height", "")
F(Squeeze,           "squeeze",           Image,    "Anamorphic squeeze",         "x",    Float,  "",                 "static.camera.anamorphicSqueeze", "")
F(RecordingWidth,    "recording_width",   Image,    "Recording width",            "px",   Int,    "Source Resolution", "static.camera.activeSensorResolution.width", "")
F(RecordingHeight,   "recording_height",  Image,    "Recording height",           "px",   Int,    "Source Resolution", "static.camera.activeSensorResolution.height", "")
F(Codec,             "codec",             Image,    "Codec",                      "",     String, "",                 "", "")
F(CaptureGamma,      "capture_gamma",     Image,    "Capture gamma",              "",     String, "",                 "", "")
F(ColourPrimaries,   "colour_primaries",  Image,    "Colour primaries",           "",     String, "",                 "", "")
F(LookName,          "look_name",         Image,    "Look / LUT",                 "",     String, "Look",             "", "")
F(SensorMode,        "sensor_mode",       Image,    "Sensor mode",                "",     String, "",                 "", "")
// ---- orientation
F(Pan,               "pan",               Orientation, "Pan",                     "deg",  Float,  "",                 "transforms[0].rotation.pan", "pan")
F(Tilt,              "tilt",              Orientation, "Tilt (+ up)",             "deg",  Float,  "Camera Tilt",      "transforms[0].rotation.tilt", "tilt")
F(Roll,              "roll",              Orientation, "Roll (+ anticlockwise from behind)", "deg", Float, "Camera Roll", "transforms[0].rotation.roll", "roll")
// ---- take / timing
F(Timecode,          "timecode",          Take,     "Timecode",                   "",     String, "Timecode",         "timing.timecode", "")
F(CameraTimecode,    "timecode_camera",   Take,     "Camera timecode",            "",     String, "",                 "", "")
// Name of the take being / last recorded, held after stop: for receivers that name a recording when it stops (Stage
// Precision). Sent before "recording" so the final name arrives before record = 0. See anc/TakeTracker.h.
F(RecordingName,     "recording_name",    Take,     "Recording name",             "",     String, "",                 "", "")
F(Recording,         "recording",         Take,     "Recording (1/0)",            "",     Int,    "",                 "tracker.recording", "")
F(Clip,              "clip",              Take,     "Clip",                       "",     String, "Clip Name",        "tracker.slate", "")
F(Reel,              "reel",              Take,     "Reel",                       "",     String, "",                 "", "")
F(Umid,              "umid",              Take,     "UMID (current take)",        "",     String, "",                 "", "")
F(Scene,             "scene",             Take,     "Scene",                      "",     String, "",                 "", "")
F(TakeName,          "take",              Take,     "Take",                       "",     String, "",                 "", "")
F(CircleTake,        "circle_take",       Take,     "Circled take",               "",     Int,    "",                 "", "")
F(Tally,             "tally",             Take,     "Tally",                      "",     Int,    "",                 "", "")
